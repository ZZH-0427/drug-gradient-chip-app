* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf
# Preserve research Dataset CSV files byte-for-byte, including their line endings.
/Dataset/**/*.csv -text !eol
.env.example text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
